{
  "scripts": {
    "build": "node esbuild.js",
    "build:watch": "cross-env ESB_WATCH=true node esbuild.js",
    "preview:popup": "pnpm build && node scripts/preview-popup.mjs",
    "pkg": "cd public && zip -9 -r gtr-ext-unpacked.zip . && mv gtr-ext-unpacked.zip ../",
    "test": "jest --testPathIgnorePatterns=test/integration test/cf-origin",
    "test:e2e:local": "jest --runInBand test/e2e/local-transload.e2e.test.ts",
    "test:integration": "jest --runInBand test/integration",
    "test:watch": "jest --watch --testPathIgnorePatterns=test/integration test/cf-origin",
    "test-origin:deploy": "pnpm --dir test/cf-origin run deploy",
    "test-origin:dev": "pnpm --dir test/cf-origin run dev",
    "test-origin:test": "pnpm --dir test/cf-origin run test",
    "test-origin:typecheck": "pnpm --dir test/cf-origin run typecheck",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "gitHooks": {
    "pre-commit": "prettier --write . && git add -A"
  },
  "jest": {
    "preset": "ts-jest/presets/js-with-ts",
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js)$": "babel-jest"
    },
    "transformIgnorePatterns": [],
    "setupFiles": [
      "dotenv/config"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@types/chrome": "^0.0.231",
    "@types/jest": "^29.5.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^9.0.1",
    "abab": "^2.0.6",
    "babel-jest": "^29.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "esbuild": "0.17.19",
    "fetch-retry": "^5.0.4",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.5.0",
    "node-fetch": "^3.3.1",
    "pako": "^2.1.0",
    "prettier": "^2.8.7",
    "pretty-bytes": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4",
    "use-chrome-storage": "^1.2.1",
    "uuid": "^9.0.0",
    "yorkie": "^2.0.0"
  }
}
